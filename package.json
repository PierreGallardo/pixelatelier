{
  "name": "pixelatelier",
  "productName": "Pixelatelier",
  "version": "0.4.0",
  "description": "Éditeur de pixel art et d'animation de bureau (Electron + React + TypeScript)",
  "main": "./out/main/index.js",
  "author": "Pixelatelier",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && electron e2e/smoke.cjs",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "app.pixelatelier.desktop",
    "productName": "Pixelatelier",
    "copyright": "Pixelatelier",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixelatelier",
      "language": "1036",
      "artifactName": "Pixelatelier-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Pixelatelier-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "app.pixelatelier.project",
            "UTTypeDescription": "Projet Pixelatelier",
            "UTTypeConformsTo": [
              "public.data"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "pixatelier"
              ],
              "public.mime-type": "application/x-pixatelier"
            }
          }
        ]
      }
    },
    "dmg": {
      "title": "Pixelatelier ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "Pixelatelier-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PierreGallardo",
        "repo": "pixelatelier",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "pixatelier",
        "name": "Projet Pixelatelier",
        "description": "Projet Pixelatelier",
        "mimeType": "application/x-pixatelier",
        "role": "Editor",
        "icon": "pixatelier"
      }
    ]
  }
}
